{
  "kind": "collectionType",
  "collectionName": "workshops",
  "info": { "singularName": "workshop", "pluralName": "workshops", "displayName": "Workshop" },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "title": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "slug": { "type": "uid", "targetField": "title", "required": true, "pluginOptions": { "i18n": { "localized": false } } },
    "category": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "description": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "heroImage": { "type": "media", "multiple": false, "allowedTypes": ["images"], "pluginOptions": { "i18n": { "localized": false } } },
    "schedule": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "ctaLabel": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "durationLabel": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "priceInr": { "type": "decimal", "min": 0, "description": "Price in rupees, e.g. 2499. Set this to take payment when people register. Empty: registration is free (no payment).", "pluginOptions": { "i18n": { "localized": false } } },
    "priceEur": { "type": "decimal", "min": 0, "description": "Price in euros for the French site, e.g. 35. Empty: no payment on the French site.", "pluginOptions": { "i18n": { "localized": false } } },
    "priceLabel": { "type": "string", "description": "Optional text shown instead of the numbers above, e.g. From ₹2,499. Leave empty to show the price automatically.", "pluginOptions": { "i18n": { "localized": false } } },
    "about": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "menu": { "type": "component", "repeatable": true, "component": "shared.line", "pluginOptions": { "i18n": { "localized": true } } },
    "menuTitle": { "type": "string", "description": "Optional. The heading of the list below (the Menu list). Empty: the page says Menu, with a food icon. For a non-food workshop write something like The Experience Flow.", "pluginOptions": { "i18n": { "localized": true } } },
    "menuNumbered": { "type": "boolean", "default": false, "description": "Tick to show 1, 2, 3 beside each line of the list instead of dots. Wrap a lead-in in double asterisks to make it bold, e.g. **The Talk:** the rest of the line.", "pluginOptions": { "i18n": { "localized": false } } },
    "notes": { "type": "component", "repeatable": true, "component": "shared.line", "pluginOptions": { "i18n": { "localized": true } } },
    "dates": { "type": "component", "repeatable": true, "component": "workshop.date", "pluginOptions": { "i18n": { "localized": true } } }
  }
}
