{
  "kind": "collectionType",
  "collectionName": "quizzes",
  "info": {
    "singularName": "quiz",
    "pluralName": "quizzes",
    "displayName": "Quiz"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "icon": {
      "type": "enumeration",
      "enum": [
        "help",
        "body",
        "skin",
        "heart",
        "leaf",
        "sparkles"
      ],
      "default": "help",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "resultTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "profileTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "balanceTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "questions": {
      "type": "component",
      "repeatable": true,
      "component": "quiz.question",
      "required": true,
      "min": 1,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "outcomes": {
      "type": "component",
      "repeatable": true,
      "component": "quiz.outcome",
      "required": true,
      "min": 2,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "instructions": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "description": "Shown above the first question."
    },
    "results": {
      "type": "component",
      "repeatable": true,
      "component": "quiz.result",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
