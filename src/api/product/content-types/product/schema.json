{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "brand": {
      "type": "string",
      "default": "VAIRUTYA",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "price": {
      "type": "decimal",
      "required": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "currency": {
      "type": "enumeration",
      "enum": [
        "USD",
        "EUR",
        "INR"
      ],
      "default": "USD",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "badge": {
      "type": "enumeration",
      "enum": [
        "new_arrival",
        "best_seller"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "tags": {
      "type": "component",
      "repeatable": true,
      "component": "shared.line",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "benefits": {
      "type": "component",
      "repeatable": true,
      "component": "shared.line",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ingredients": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "howToUse": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "tabs": {
      "type": "component",
      "repeatable": true,
      "component": "product.tab",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "priceInr": {
      "type": "decimal",
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "description": "Price in rupees, GST included. Leave empty to not sell in India."
    },
    "priceEur": {
      "type": "decimal",
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "description": "Price in euros. Leave empty to not sell in France."
    }
  }
}
